<?xml version="1.0"?>
<ruleset name="Follow on Google Buttons">
	<description>Coding standards for the Follow on Google Buttons plugin.</description>

	<!-- What to scan. -->
	<file>.</file>

	<!-- What to skip. -->
	<exclude-pattern>/vendor/</exclude-pattern>
	<exclude-pattern>/node_modules/</exclude-pattern>
	<exclude-pattern>/build/</exclude-pattern>

	<!-- Show progress and use colors; only scan PHP. -->
	<arg value="ps"/>
	<arg name="extensions" value="php"/>

	<!-- Run in parallel for speed. -->
	<arg name="parallel" value="8"/>

	<!-- Enforce the WordPress standards. -->
	<rule ref="WordPress">
		<!--
			Allow our short function prefix "fog_". The directory requires a
			unique prefix; fog_ is ours. Adjust if you pick a longer one.
		-->
	</rule>

	<!-- Require our text domain for all translation functions. -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="follow-on-google"/>
			</property>
		</properties>
	</rule>

	<!-- Require our prefix on globals/functions/hooks. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="fog"/>
				<element value="follow_on_google"/>
			</property>
		</properties>
	</rule>

	<!-- Check PHP cross-version compatibility for the versions we support. -->
	<config name="testVersion" value="7.4-"/>
	<rule ref="PHPCompatibilityWP"/>

	<!-- Tell WPCS which WP version we target (affects some sniffs). -->
	<config name="minimum_wp_version" value="6.4"/>
</ruleset>
